# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local storage
DATABASE_PATH=data/dynamic/parking.db
VECTOR_STORE_PATH=data/vector_store
RESERVATIONS_FILE_PATH=data/dynamic/reservations.txt

# Models will be selected in Stage 1.
LLM_PROVIDER=not-configured
LLM_MODEL=replace-with-model-name
EMBEDDING_MODEL=replace-with-embedding-model-name

# Optional. Never commit a real key.
OPENAI_API_KEY=
